{
  "name": "lifetally",
  "version": "0.1.0",
  "description": "A local-first personal calendar, sticky-note inbox, and wallpaper library.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cang6ng/LifeTally.git"
  },
  "bugs": {
    "url": "https://github.com/cang6ng/LifeTally/issues"
  },
  "homepage": "https://github.com/cang6ng/LifeTally#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "calendar",
    "indexeddb",
    "local-first",
    "productivity",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test": "vite build --ssr src/tests/unit.test.ts --outDir .test-dist --emptyOutDir && node .test-dist/unit.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "antd": "^5.20.0",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.21",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "typescript": "^5.5.3",
    "vite": "^8.2.2"
  }
}
